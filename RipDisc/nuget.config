<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only, so a restore never depends on feeds configured elsewhere on the machine -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
