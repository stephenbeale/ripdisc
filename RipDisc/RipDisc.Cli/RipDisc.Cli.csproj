<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keep the executable named RipDisc.exe, as in earlier releases -->
    <AssemblyName>RipDisc</AssemblyName>
    <RootNamespace>RipDisc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RipDisc.Core\RipDisc.Core.csproj" />
  </ItemGroup>

</Project>
